# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=kisansetu_db
DATABASE_USER=root
DATABASE_PASSWORD=

# Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Third Party APIs
# Register at data.gov.in to get this free API key
DATA_GOV_API_KEY=

# SMS Provider Configuration (set SMS_PROVIDER to 'mock' for local dev without real SMS)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=KSETU

# CORS Config
FRONTEND_URL=http://localhost:5500
